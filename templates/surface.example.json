{
  "openapi": "3.0.3",
  "info": {
    "title": "Widget API",
    "version": "1.4.0"
  },
  "paths": {
    "/widgets": {
      "get": {
        "summary": "List widgets",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["active", "archived", "draft"]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of widgets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items", "total"],
                  "properties": {
                    "items": {
                      "type": "array"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "cursor": {
                      "type": "string",
                      "nullable": false
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a widget",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string",
                    "enum": ["red", "green", "blue"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created widget",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "name"],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "shade": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/widgets/{id}": {
      "get": {
        "summary": "Fetch one widget",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The widget",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/legacy-export": {
      "get": {
        "summary": "Export the catalog the old way",
        "responses": {
          "200": {
            "description": "A dump",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rows": {
                      "type": "array"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
